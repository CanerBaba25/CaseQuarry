{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaseQuarry",
  "version": "0.7.0",
  "identifier": "com.casequarry.desktop",
  "build": {
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "connection",
        "title": "CaseQuarry — Firm connection",
        "width": 1000,
        "height": 740,
        "minWidth": 660,
        "minHeight": 580,
        "center": true,
        "devtools": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["connection-settings"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "shortDescription": "Connect to your firm's CaseQuarry evidence workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
