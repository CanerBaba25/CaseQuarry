{
  "name": "@casequarry/web",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 0.0.0.0 --port 3000",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test:e2e": "uv run --project ../.. python ../../scripts/tasks.py test-e2e",
    "format:check": "prettier --check src scripts package.json tsconfig.json next.config.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
