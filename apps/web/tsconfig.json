{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/e2e-20261012T214736-58b394/types/**/*.ts",
    ".next/e2e-20261012T214736-58b394/dev/types/**/*.ts",
    ".next/e2e-20261012T214811-48ed8e/types/**/*.ts",
    ".next/e2e-20261012T214811-48ed8e/dev/types/**/*.ts",
    ".next/e2e-20261012T214913-425730/types/**/*.ts",
    ".next/e2e-20261012T214913-425730/dev/types/**/*.ts",
    ".next/e2e-20261012T215032-776e1e/types/**/*.ts",
    ".next/e2e-20261012T215032-776e1e/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
