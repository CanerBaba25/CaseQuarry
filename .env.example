# Generate local secrets with: uv run python scripts/tasks.py init
# Never commit .env or use confidential evidence in this development release.
CASEQUARRY_SETUP_TOKEN=
CASEQUARRY_DATABASE_URL=sqlite:///.data/casequarry.db
CASEQUARRY_STORAGE_ROOT=.data/storage
CASEQUARRY_WORKER_MODE=embedded
CASEQUARRY_AI_ENABLED=false
CASEQUARRY_ALLOW_REMOTE_AI=false
CASEQUARRY_ALLOW_INSECURE_LOCAL_COOKIES=true

# Docker Compose uses these generated credentials and its own internal DB URL.
POSTGRES_PASSWORD=
WEB_PORT=3000
CASEQUARRY_API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
