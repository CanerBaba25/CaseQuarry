# Generate local secrets with: uv run python scripts/tasks.py init
# Never commit .env or use confidential evidence in this development release.
CASEQUARRY_SETUP_TOKEN=
# init generates a private authenticated PostgreSQL URL. No default database password.
CASEQUARRY_DATABASE_URL=postgresql+psycopg://casequarry@127.0.0.1:5432/casequarry
CASEQUARRY_STORAGE_ROOT=.data/storage
CASEQUARRY_WORKER_MODE=embedded
CASEQUARRY_WORKER_IMPORT_RECORDS_PER_TICK=25
CASEQUARRY_OCR_ENABLED=true
CASEQUARRY_OCR_LANGUAGE=eng
CASEQUARRY_OCR_TIMEOUT_SECONDS=60
CASEQUARRY_OCR_MAX_PAGES=200
CASEQUARRY_OCR_MAX_PIXELS=25000000
CASEQUARRY_EXTRACTION_TIMEOUT_SECONDS=180
# Optional absolute local executable; otherwise standard installed locations are detected.
CASEQUARRY_TESSERACT_COMMAND=
CASEQUARRY_AI_ENABLED=false
# Capability only: firm policy, matter consent and per-job confirmation still default disabled.
CASEQUARRY_ALLOW_REMOTE_AI=true
CASEQUARRY_PROVIDER_KEY_ENCRYPTION_KEY=
# Optional dedicated Ed25519 PEM key; leave empty for unsigned evidence ZIPs.
CASEQUARRY_EXPORT_SIGNING_KEY_FILE=
CASEQUARRY_ALLOW_INSECURE_LOCAL_COOKIES=true

# Docker Compose uses these generated credentials and its own internal DB URL.
POSTGRES_PASSWORD=
WEB_PORT=3000
CASEQUARRY_API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
